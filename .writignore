# .writignore — controls which files writ tracks.
# Generated by `writ init`. Edit freely.
#
# Syntax: directory names, glob patterns (*.ext), or # comments.
# .writ is always ignored regardless of this file.

# --- writ defaults ---
.writ
.git
target
node_modules
.venv
__pycache__
.pytest_cache

# --- imported from .gitignore ---
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db
*.py[cod]
*.egg-info/
.venv*/
venv/
book/book/
tmp/
testing/
crates/writ-py/writ.data/scripts/writ
crates/writ-py/writ.data/scripts/writ.exe
docs/
scratch.md
CLAUDE.md
scripts/
old_readmes/
*.dSYM/

# compiled python extension (in global gitignore; writ 0.2.0 does not read global excludes)
*.so
.venv311
build
